    {
      "kind": "financials",
      "title": "Financial trends",
      "claims": [
        {
          "text": "Gross margin rose from 53.6% in FY2023Q3 to 75.0% in FY2027Q2, with a dip to 60.5% in FY2026Q1.",
          "source_ids": [
            "9362144197",
            "c1a63d8899",
            "ed94e83dd6"
          ],
          "confidence": "high"
        },
        {
          "text": "Operating margin rose from 10.1% in FY2023Q3 to 66.2% in FY2027Q2.",
          "source_ids": [
            "9362144197",
            "c1a63d8899"
          ],
          "confidence": "high"
        },
        {
          "text": "Net margin rose from 11.5% in FY2023Q3 to 62.0% in FY2027Q2.",
          "source_ids": [
            "9362144197",
            "c1a63d8899"
          ],
          "confidence": "high"
        },
        {
          "text": "R&D expense increased from 1,945 USD millions in FY2023Q3 to 7,054 USD millions in FY2027Q2.",
          "source_ids": [
            "9362144197",
            "c1a63d8899"
          ],
          "confidence": "high"
        },
        {
          "text": "Cost of revenue increased from 2,754 USD millions in FY2023Q3 to 24,079 USD millions in FY2027Q2.",
          "source_ids": [
            "9362144197",
            "c1a63d8899"
          ],
          "confidence": "high"
        },
        {
          "text": "Year-over-year revenue growth decelerated from 262.1% in FY2025Q1 to 55.6% in FY2026Q2, then reaccelerated to 105.8% in FY2027Q2.",
          "source_ids": [
            "1084f83b7a",
            "e2d0285c65",
            "c1a63d8899"
          ],
          "confidence": "high"
        },
        {
          "text": "Quarter-over-quarter revenue growth slowed to 6.1% in FY2026Q2 before rebounding to 22.0% in FY2026Q3 and 17.9% in FY2027Q2.",
          "source_ids": [
            "e2d0285c65",
