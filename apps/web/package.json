{
  "name": "trading-research-agent-web",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.20.0",
  "scripts": {
    "predev": "pnpm run types && node scripts/sync-fixtures.mjs",
    "dev": "next dev",
    "prebuild": "pnpm run types && node scripts/sync-fixtures.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "pretypecheck": "pnpm run types",
    "typecheck": "tsc --noEmit",
    "types": "json2ts ../../packages/contracts/report.schema.json -o src/types/report.ts --no-additionalProperties"
  },
  "dependencies": {
    "next": "^16.3.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.39.0",
    "eslint-config-next": "^16.3.3",
    "json-schema-to-typescript": "^15.0.4",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3"
  }
}
