# ---- LLM ----
# Works with any OpenAI-compatible endpoint (OpenAI, DeepSeek, Moonshot, OpenRouter, ...)
TRA_LLM_API_KEY=sk-xxxx
TRA_LLM_BASE_URL=https://api.openai.com/v1
TRA_LLM_MODEL=gpt-4.1-mini
# 单次调用超时（秒）。别留默认的超长值：一次卡住的请求会让整个流程静默挂死。
TRA_LLM_TIMEOUT_SECONDS=180
TRA_LLM_MAX_RETRIES=1

# ---- SEC EDGAR ----
# SEC requires a descriptive User-Agent with a contact email. Requests without
# one get 403. Max 10 requests/second.
TRA_SEC_USER_AGENT=trading-research-agent your-email@example.com

# ---- Search (M4+) ----
# TRA_TAVILY_API_KEY=tvly-xxxx

# ---- Misc ----
TRA_CACHE_DIR=.cache
TRA_LOG_LEVEL=INFO
